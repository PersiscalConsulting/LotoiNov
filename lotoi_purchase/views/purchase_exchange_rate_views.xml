<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lotoi_purchase_order_form_exchange_rate" model="ir.ui.view">
        <field name="name">lotoi_purchase_order_form_exchange_rate</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="company_currency_id" invisible="1"/>
                <field name="currency_rate" invisible="1"/>
                <field name="lotoi_exchange_rate"
                       invisible="currency_id == company_currency_id"
                       readonly="state in ('cancel', 'done')"/>
            </xpath>
        </field>
    </record>

    <record id="lotoi_account_move_form_fixed_rate" model="ir.ui.view">
        <field name="name">lotoi_account_move_form_fixed_rate</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="lotoi_fixed_currency_rate" invisible="1"/>
            </xpath>
        </field>
    </record>

    <template id="lotoi_report_purchaseorder_exchange_rate" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[@id='informations']/div[last()]" position="after">
            <div t-if="o.currency_id != o.company_id.currency_id and o.currency_rate" class="col-2 bm-2">
                <strong>Tipo de cambio:</strong>
                <p class="m-0">
                    1 <span t-field="o.currency_id.name"/> = <span t-out="'%.2f' % (1 / o.currency_rate)"/> <span t-field="o.company_id.currency_id.name"/>
                </p>
            </div>
        </xpath>
    </template>
</odoo>
