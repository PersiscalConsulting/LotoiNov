<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lotoi_view_account_invoice_filter_week" model="ir.ui.view">
        <field name="name">lotoi_account_invoice_filter_week</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="lotoi_week_number" string="Semana (número)"/>
                <field name="lotoi_week" string="Semana (año-semana)"/>
            </xpath>
            <xpath expr="//filter[@name='invoicedate']" position="after">
                <filter string="Semana" name="lotoi_group_week" context="{'group_by': 'lotoi_week'}"/>
            </xpath>
        </field>
    </record>

    <record id="lotoi_view_in_invoice_bill_tree_week" model="ir.ui.view">
        <field name="name">lotoi_account_in_invoice_bill_tree_week</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="lotoi_week" string="Semana" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="lotoi_view_out_invoice_tree_week" model="ir.ui.view">
        <field name="name">lotoi_account_out_invoice_tree_week</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="lotoi_week" string="Semana" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
