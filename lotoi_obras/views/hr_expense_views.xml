<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_view_form_lotoi_obras" model="ir.ui.view">
        <field name="name">hr.expense.view.form.lotoi.obras</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- "Referencia" becomes a selection of the works; the text field stays hidden in sync. -->
            <xpath expr="//field[@name='x_studio_reference']" position="replace">
                <field name="lotoi_obra_id" string="Referencia"
                       options="{'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
